            <p class="text-gray-500">hello literally everyone</p>
        </div>  
        
      </section>
    </main>
    
    <footer class="py-2 space-y- w-[25%] " >
      <div class="relative">
        <div class="text-center text-s text-gray-500 bg-[rgb(32,35,39)] w-auto h-auto rounded-full border-md border-gray mx-2 px-2 focus:outline-none">
          <input type="text" name="name" id="" placeholder="Search Twitter" class="bg-transparent text-center" >
          <img src="/public/images/Vector (20).svg" alt="" class="absolute left-6  top-1">
        </div>
        
      </div>
      
      <div class="bg-[rgb(32,35,39)] space-y-4 rounded border-md border-gray-200 m-2 p-2">

        <div class=" ">

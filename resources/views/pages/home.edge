        <div></div>

        
        <div class="flex gap-2 m-2">
          
          <img src="/public/images/image 1 (2).svg" alt="png" class="w-auto h-10 mx-2 ">
        <div class="">
          <div class="flex items-center gap-1">
            <p class="text-white font-semibold ">Twitter</p>
            <img src="/public/images/Group (2)0.svg" alt="">
            <p class="text-gray-500 text-xs">@Twitter. Oct 4</p>
          </div>
          <div class="text-gray-500">
            <p>hello literally everyone</p>
          </div>
      
        </div>  
        
      </section>
    </main>
    <footer class="py-2 space-y-2">
      <div class="relative">
        <div class="text-center text-s text-gray-500 bg-gray-800 w-auto h-auto rounded-full border-md border-gray mx-2 px-2 focus:outline-none">
          <input type="text" name="name" id="" placeholder="Search Twitter" class="bg-transparent text-center" >
          <img src="/public/images/Vector (20).svg" alt="" class="absolute left-6  top-1">
        </div>
        
      </div>
      

      <div class="bg-gray-800 space-y-4 rounded border-md border-gray-200 m-2 p-2">

        <div class=" ">

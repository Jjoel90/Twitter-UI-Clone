                </div>
                
                <p class="text-gray-400 text-sm"> @nytimes. 2h </p> 
              </div>
            </div>
          </div>
          
          <button type="submit" class="bg-white text-gray-900 text-sm hover:bg-gray-600 text-black text-xs px-3 py-1 rounded-full border-md w-auto h-6">Follow</button>

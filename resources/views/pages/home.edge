          <div class="">
            <div class="flex items-center gap-1">
              <p class="text-white font-semibold">Twitter</p>
              <img src="/public/images/Group (2)0.svg" alt="">
              <p class="text-gray-500 text-xs">@Twitter. Oct 4</p>
            </div>
            <div class="text-gray-500">
              <p>hello literally everyone</p>
       
            </div>
        
